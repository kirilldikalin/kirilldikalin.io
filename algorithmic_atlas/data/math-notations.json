{
  "schemaVersion": 1,
  "entries": [
    {
      "id": "input-set-x",
      "displayNotation": "X",
      "shortName": "множество входов",
      "explanation": "Множество всех входных объектов, для которых задана рассматриваемая процедура",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "before-computers",
        "anchor": "state-model"
      }
    },
    {
      "id": "output-set-y",
      "displayNotation": "Y",
      "shortName": "множество результатов",
      "explanation": "Множество возможных результатов вычисления",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "before-computers",
        "anchor": "state-model"
      }
    },
    {
      "id": "state-space-s",
      "displayNotation": "S",
      "shortName": "пространство состояний",
      "explanation": "Множество всех допустимых состояний последовательного вычисления",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "before-computers",
        "anchor": "state-model"
      }
    },
    {
      "id": "state-s-t",
      "displayNotation": "s_t",
      "shortName": "состояние на шаге t",
      "explanation": "Полное состояние процедуры после t выполненных переходов",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "before-computers",
        "anchor": "state-model"
      }
    },
    {
      "id": "transition-f",
      "displayNotation": "F",
      "shortName": "переход",
      "explanation": "Правило, которое по текущему незавершающему состоянию строит следующее",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "before-computers",
        "anchor": "state-model"
      }
    },
    {
      "id": "halting-set-h",
      "displayNotation": "H",
      "shortName": "завершающие состояния",
      "explanation": "Подмножество состояний, в которых процедура прекращает выполнять переходы",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "before-computers",
        "anchor": "state-model"
      }
    },
    {
      "id": "partial-function-f",
      "displayNotation": "f",
      "shortName": "частичная вычисляемая функция",
      "explanation": "Соответствие входа результату, которое может быть не определено для части входов, например из-за незавершения процедуры",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "before-computers",
        "anchor": "state-model"
      }
    },
    {
      "id": "partial-arrow",
      "displayNotation": "\\rightharpoonup",
      "shortName": "частичное отображение",
      "explanation": "Стрелка показывает, что функция может не иметь результата для некоторых допустимых входов",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "before-computers",
        "anchor": "state-model"
      }
    },
    {
      "id": "gcd",
      "displayNotation": "\\gcd(a,b)",
      "shortName": "наибольший общий делитель",
      "explanation": "Наибольший положительный целый делитель обоих чисел a и b; для нулевых аргументов используется соглашение главы",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "euclidean-algorithm",
        "anchor": "divisibility"
      }
    },
    {
      "id": "modulo",
      "displayNotation": "a\\bmod b",
      "shortName": "остаток от деления",
      "explanation": "Единственный остаток r в разложении a=qb+r при 0≤r<b и b>0",
      "scope": "global",
      "chapterId": null,
      "firstDefinition": {
        "chapterId": "euclidean-algorithm",
        "anchor": "remainder"
      }
    },
    {
      "id": "quotient-q",
      "displayNotation": "q",
      "shortName": "неполное частное",
      "explanation": "Целое число полных копий b, помещающихся в a при делении с остатком",
      "scope": "local",
      "chapterId": "euclidean-algorithm",
      "firstDefinition": {
        "chapterId": "euclidean-algorithm",
        "anchor": "remainder"
      }
    },
    {
      "id": "remainder-r",
      "displayNotation": "r",
      "shortName": "остаток",
      "explanation": "Неотрицательная часть a, оставшаяся после вычитания q полных копий b; всегда меньше b",
      "scope": "local",
      "chapterId": "euclidean-algorithm",
      "firstDefinition": {
        "chapterId": "euclidean-algorithm",
        "anchor": "remainder"
      }
    },
    {
      "id": "tm-state-set-q",
      "displayNotation": "Q",
      "shortName": "множество состояний машины",

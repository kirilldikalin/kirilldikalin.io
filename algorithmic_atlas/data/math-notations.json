      "chapterId": "asymptotic-estimates",
      "firstDefinition": {
        "chapterId": "asymptotic-estimates",
        "anchor": "big-o-definition"
      }
    },
    {
      "id": "forall-positive-constant",
      "displayNotation": "\\forall c>0",
      "shortName": "для любого положительного множителя",

      "scope": "local",
      "chapterId": "turing-machine-transition",
      "firstDefinition": {
        "chapterId": "turing-machine-transition",
        "anchor": "formal-machine"
      }
    },
    {
      "id": "input-alphabet-sigma",
      "displayNotation": "\\Sigma",

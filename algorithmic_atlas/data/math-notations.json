      "chapterId": null,
      "firstDefinition": {
        "chapterId": "asymptotic-estimates",
        "anchor": "strict-relations"
      }
    },
    {
      "id": "exists-quantifier",
      "displayNotation": "\\exists",
      "shortName": "существует",
